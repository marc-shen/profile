emacs.d/projects.eld
emacs.d/projects
emacs.d/tramp
emacs.d/auto-save-list/
emacs.d/eshell/
emacs.d/transient/
emacs.d/log/
emacs.d/agent/
emacs.d/tramp-rpc/
**/__pycache__/
.DS_Store

emacs.d/.cache/
