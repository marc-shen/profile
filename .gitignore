config/emacs/eln-cache
config/emacs/var
# Written by the Customize interface, so its contents describe one machine.
config/emacs/custom.el

# Local Emacs runtime when ~/.emacs.d links to the whole checkout.
config/emacs/tree-sitter
config/emacs/projects.eld
config/emacs/projects
config/emacs/tramp
config/emacs/auto-save-list
config/emacs/eshell
config/emacs/transient
config/emacs/log
config/emacs/agent
config/emacs/tramp-rpc
**/__pycache__/
.DS_Store

config/emacs/.cache

# Local migration aliases keep running processes and old launchers alive.
/scripts
/platform
/manifests
/shell
/emacs.d
/helix
/modulefiles
/zshrc
/wezterm.lua
/starship.toml
/archieve
