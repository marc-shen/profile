{
  "schema": 1,
  "name": "network",
  "description": "Steam Deck 代理、302 与 Tailscale",
  "platforms": [
    "steamdeck"
  ],
  "requires": [
    "managers"
  ],
  "entrypoint": [
    "{python}",
    "{component}/run.py"
  ],
  "actions": {
    "list": {
      "description": "列出对象与本机状态",
      "platforms": [
        "macos",
        "steamdeck",
        "fedora",
        "ubuntu",
        "debian"
      ]
    },
    "check": {
      "description": "检查配置和安装状态"
    },
    "install": {
      "description": "补齐缺失项目，保留已有安装"
    },
    "update": {
      "description": "显式更新已选择的项目"
    },
    "apply": {
      "description": "首次授权、安装系统服务并启用"
    },
    "start": {
      "description": "启动后台"
    },
    "stop": {
      "description": "停止后台"
    },
    "restart": {
      "description": "重启后台"
    },
    "status": {
      "description": "查看后台状态"
    },
    "logs": {
      "description": "查看日志"
    },
    "open": {
      "description": "打开客户端或网页"
    }
  },
  "targets": [
    "all",
    "mihomo",
    "sc302",
    "tailscale"
  ]
}
