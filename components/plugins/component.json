{
  "schema": 1,
  "name": "plugins",
  "description": "Zsh 插件及补全",
  "platforms": [
    "macos",
    "steamdeck",
    "fedora",
    "ubuntu",
    "debian"
  ],
  "requires": [
    "managers"
  ],
  "entrypoint": [
    "{python}",
    "{component}/run.py"
  ],
  "actions": {
    "list": {
      "description": "列出对象与本机状态"
    },
    "check": {
      "description": "检查配置和安装状态"
    },
    "install": {
      "description": "补齐缺失项目，保留已有安装"
    },
    "update": {
      "description": "显式更新已选择的项目"
    }
  },
  "targets": {
    "catalog": "catalog/zsh-plugins.sources",
    "format": "sources"
  }
}
