{
  "schema": 1,
  "name": "profile",
  "description": "配置部署与 Git 同步",
  "platforms": [
    "macos",
    "steamdeck",
    "fedora",
    "ubuntu",
    "debian"
  ],
  "requires": [],
  "entrypoint": [
    "{python}",
    "{component}/run.py"
  ],
  "actions": {
    "list": {
      "description": "列出配置范围"
    },
    "check": {
      "description": "检查配置与命令",
      "options": {
        "--only <scope>": "范围：all|shell|emacs|helix（默认 all）"
      }
    },
    "install": {
      "description": "部署配置并补齐缺失依赖",
      "options": {
        "--only <scope>": "范围：all|shell|emacs|helix|network（默认 all）",
        "--config-only": "仅部署配置，跳过依赖安装和 LSP 探测"
      }
    },
    "apply": {
      "description": "部署当前工作树；--config-only 跳过依赖安装",
      "options": {
        "--only <scope>": "范围：all|shell|emacs|helix|network（默认 all）",
        "--config-only": "仅部署配置，跳过依赖安装和 LSP 探测"
      }
    },
    "update": {
      "description": "Git 快进拉取并部署",
      "options": {
        "--only <scope>": "范围：all|shell|emacs|helix|network（默认 all）",
        "--config-only": "仅部署配置，跳过依赖安装和 LSP 探测"
      }
    },
    "plan": {
      "description": "查看配置变化",
      "options": {
        "--only <scope>": "范围：all|shell|emacs|helix|network（默认 all）",
        "--config-only": "仅部署配置，跳过依赖安装和 LSP 探测"
      }
    },
    "link": {
      "description": "仅部署配置链接",
      "options": {
        "--only <scope>": "范围：all|shell|emacs|helix（默认 all）"
      }
    }
  },
  "arguments": ""
}
