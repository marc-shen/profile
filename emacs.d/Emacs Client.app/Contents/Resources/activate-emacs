#!/bin/bash

set -euo pipefail

client=/Applications/Emacs.app/Contents/MacOS/bin/emacsclient

# LaunchServices may append a process serial number on older macOS versions;
# it is not an Emacs argument.
new_window=false
arguments=()
for argument in "$@"; do
  case "$argument" in
    -psn_*) ;;
    --new-window) new_window=true ;;
    *) arguments+=("$argument") ;;
  esac
done

if ! "$client" --timeout=5 --eval t >/dev/null 2>&1; then
  domain="gui/$(id -u)"
  service="$domain/org.gnu.emacs.daemon"
  plist="$HOME/Library/LaunchAgents/org.gnu.emacs.daemon.plist"
  if ! launchctl print "$service" >/dev/null 2>&1; then
   if [[ ! -r $plist ]]; then
    echo "Missing $plist; run ./bootstrap.sh service from the profile checkout." >&2
    exit 1
   fi
   # A stopped/unloaded service needs bootstrap, not just kickstart.
   # Another launcher may win the race to load it; verify before failing.
   if ! launchctl bootstrap "$domain" "$plist"; then
    launchctl print "$service" >/dev/null 2>&1 || exit 1
   fi
  fi
  # No -k: never kill a running daemon or its unsaved buffers.
  launchctl kickstart "$service" >/dev/null
  ready=false
  for _ in {1..20}; do
    if "$client" --timeout=1 --eval t >/dev/null 2>&1; then
      ready=true
      break
    fi
    sleep 0.25
  done
  if ! $ready; then
    echo "Emacs daemon is not responding. Save or recover unsaved buffers before restarting it." >&2
    exit 1
  fi
fi

# The Dock associates the frame with the daemon's Emacs.app process rather
# than with this launcher.  Make that process an AppKit accessory so the
# pinned Emacs Client tile is the only Emacs icon in the Dock.  Accessory apps
# can still own normal windows; they simply have no separate Dock tile.
hide_emacs_dock_icon="(when (and (featurep 'ns) (fboundp 'ns-do-applescript)) (ns-do-applescript \"use framework \\\"AppKit\\\"\\ncurrent application's NSApplication's sharedApplication()'s setActivationPolicy:1\"))"
"$client" --timeout=5 --eval "$hide_emacs_dock_icon" >/dev/null 2>&1 || true

# Tag the frame so activation targets this request's window, even if
# another client changes the selected frame while this helper is running.
target_frame_id="dock-$$-$RANDOM"
create_window() {
  local parameters="((emacs-client-launch-id . \"$target_frame_id\"))"
  # Bash 3.2 treats an empty array as unset under nounset.
  if [ "${#arguments[@]}" -gt 0 ]; then
    "$client" --timeout=10 --no-wait --create-frame --frame-parameters "$parameters" "${arguments[@]}"
  else
    "$client" --timeout=10 --no-wait --create-frame --frame-parameters "$parameters"
  fi
}

if $new_window || [ "${#arguments[@]}" -gt 0 ]; then
  create_window
else
  # Returning from another app should resume the selected editing frame,
  # not cycle to an unrelated window. Include minimized windows, but skip
  # the daemon terminal and child frames (completion popups, tooltips, etc.).
  # Only choose/tag here: activate after the final Dock policy change below.
  activated=$("$client" --timeout=5 --eval "(let* ((frames (seq-filter
                                   (lambda (frame)
                                     (and (display-graphic-p frame)
                                          (not (frame-parent frame))))
                                   (frame-list)))
                           (selected (or (frame-parent (selected-frame))
                                         (selected-frame)))
                           (frame (or (car (memq selected frames))
                                      (car frames))))
    (when frame
      (set-frame-parameter frame 'emacs-client-launch-id \"$target_frame_id\")
      t))")
  # With no GUI frames, --eval runs in the daemon's terminal context.
  # A plain (make-frame) then fails with "Unknown terminal type". Let
  # emacsclient establish the graphical display and create the first frame.
  if [ "$activated" = nil ]; then
    create_window
  fi
fi

# Creating the first GUI frame can promote a daemon back to a regular AppKit
# application.  Apply the accessory policy again after Emacs has finished
# creating the frame.
"$client" --timeout=5 --eval "$hide_emacs_dock_icon" >/dev/null 2>&1 || true

# Set the final Dock policy before activating: changing application policy
# after focusing a window can leave the launcher (or another app) in front.
"$client" --timeout=5 --eval "(let ((frame (seq-find
      (lambda (frame)
        (equal (frame-parameter frame 'emacs-client-launch-id)
               \"$target_frame_id\"))
      (frame-list))))
    (when frame
      (make-frame-visible frame)
      (when (and (featurep 'ns) (fboundp 'ns-do-applescript))
        (ns-do-applescript
          \"use framework \\\"AppKit\\\"\\ncurrent application's NSApplication's sharedApplication()'s activateIgnoringOtherApps:true\"))
      (select-frame-set-input-focus frame)
      (raise-frame frame)
      (set-frame-parameter frame 'emacs-client-launch-id nil)))" >/dev/null
