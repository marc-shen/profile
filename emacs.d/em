#!/usr/bin/env bash

set -euo pipefail

if [ "$#" -eq 0 ]; then
    set -- "$PWD"
fi

# Resolve relative paths before emacsclient changes the selected frame's
# context.  Keep arguments in an array: an eval-based reconstruction would
# misparse quotes and allow shell syntax embedded in a file name to execute.
arguments=()

for argument in "$@"; do
    case "$argument" in
        -*|+[0-9]*)
            arguments+=("$argument")
            ;;
        /*)
            arguments+=("$argument")
            ;;
        *)
            arguments+=("$PWD/$argument")
            ;;
    esac
done

if emacsclient -n -c "${arguments[@]}" >/dev/null 2>&1; then
    exit 0
fi

echo "Emacs server is not running" >&2
exit 1
