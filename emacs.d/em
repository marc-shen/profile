#!/bin/sh

if [ "$#" -eq 0 ]; then
    set -- "$PWD"
fi

# emacsclient resolves relative names against the server's working directory,
# not ours, so turn every path argument into an absolute one first.
for arg in "$@"; do
    case "$arg" in
        -*|+[0-9]*) ;;
        /*) ;;
        *) arg="$PWD/$arg" ;;
    esac
    set -- "$@" "$arg"
    shift
done

if emacsclient -n "$@" 2>/dev/null; then
    exit 0
else
    emacs "$@" >/dev/null 2>&1 </dev/null &
    command -v disown >/dev/null 2>&1 && disown
fi
