#%Module1.0

proc ModulesHelp { } {
    puts stderr "HDF5 1.14.6 parallel build for Fedora OpenMPI."
    puts stderr "Loads mpi/openmpi-x86_64 and exposes h5pcc/h5pfc."
}

module-whatis "HDF5 1.14.6 parallel build with GNU Fortran and OpenMPI"

conflict hdf5
conflict mpi/mpich-x86_64
conflict empi/mpich
conflict intel/mpi

prereq mpi/openmpi-x86_64

set root       /usr/lib64/openmpi
set module_dir /usr/lib64/gfortran/modules/openmpi

setenv HDF5_ROOT               $root
setenv HDF5_VERSION            1.14.6
setenv HDF5_FLAVOR             openmpi
setenv HDF5_FORTRAN_MODULE_DIR $module_dir

prepend-path LIBRARY_PATH $root/lib
prepend-path CPATH         $module_dir
