{
  "schema": 1,
  "name": "emacs",
  "description": "Emacs 运行时、包与用户服务",
  "platforms": [
    "macos",
    "steamdeck",
    "fedora",
    "ubuntu",
    "debian"
  ],
  "requires": [
    "platform",
    "tools"
  ],
  "entrypoint": [
    "{python}",
    "{module}/run.py"
  ],
  "actions": {
    "list": {
      "description": "列出对象与本机状态"
    },
    "check": {
      "description": "检查配置和安装状态"
    },
    "install": {
      "description": "补齐缺失项目，保留已有安装"
    },
    "update": {
      "description": "显式更新已选择的项目"
    },
    "apply": {
      "description": "部署配置或服务定义，不重启运行中的进程"
    },
    "start": {
      "description": "启用并启动用户服务"
    },
    "stop": {
      "description": "停止用户服务"
    },
    "restart": {
      "description": "重启用户服务"
    },
    "status": {
      "description": "查看服务状态"
    },
    "logs": {
      "description": "查看服务日志"
    }
  },
  "targets": [
    "runtime",
    "packages",
    "service"
  ]
}
