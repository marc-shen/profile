;;; verify-emacs.el --- Verify the installed environment -*- lexical-binding: t; -*-
(setq user-emacs-directory (file-name-as-directory (expand-file-name "~/.emacs.d")))
(load (expand-file-name "early-init.el" user-emacs-directory) nil nil t)
(load (expand-file-name "init.el" user-emacs-directory) nil nil t)
(unless (and (featurep 'init-git) (featurep 'init-helix)
             (null (my-missing-core-packages)))
  (error "Profile did not finish loading"))
(dolist (entry my-vc-packages)
  (unless (package-installed-p (car entry))
    (error "Missing VC package: %s" (car entry))))
(dolist (language init-treesit-languages)
  (unless (treesit-language-available-p language)
    (error "Missing grammar: %s" language)))
(my-install-vterm-module)
(require 'pdf-info)
(pdf-info-check-epdfinfo)
(with-temp-buffer
  (insert "def hello():\n    return 42\n")
  (python-ts-mode)
  (unless (equal (treesit-node-type (treesit-buffer-root-node)) "module")
    (error "Python Tree-sitter parsing failed")))
(dolist (command '("uv" "pixi" "fd" "rg" "zoxide" "zsh" "cc" "cmake"))
  (unless (executable-find command)
    (error "Missing subprocess command: %s" command)))
(princ (format "PASS: Emacs %s; full profile; %d core packages; %d grammars; vterm; PDF Tools; Python parsing; tool PATH\n"
               emacs-version (length my-core-packages) (length init-treesit-languages)))
