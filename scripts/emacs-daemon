#!/usr/bin/env bash
set -euo pipefail
root=${SOFTWARE_HOME:-$HOME/Software}
[[ ! -r $root/env.sh ]] || source "$root/env.sh"
source "${PROFILE_HOME:-$root/config/profile}/scripts/emacs-x11-auth.sh"
# Do not retain KDE's temporary per-login authority filename in a long-lived daemon.
if [[ $(uname -s) == Linux ]]; then export XAUTHORITY="$HOME/.Xauthority"; fi
# Optional machine choice of native binary (not a frontend invoking emacsclient).
if [[ -n ${EMACS_BINARY:-} ]]; then exec "$EMACS_BINARY" --fg-daemon; fi
# The native daemon and launcher share one bundle identity and one Dock tile.
if [[ $(uname -s) == Darwin && -x "$HOME/Applications/Emacs Client.app/Contents/MacOS/Emacs" ]]; then
 bundle="$HOME/Applications/Emacs Client.app"
 # Only prepare at process startup: an editing session is never restarted here.
 if [[ -f "$bundle/Contents/Resources/prepare-runtime.py" ]]; then
  /usr/bin/python3 -B "$bundle/Contents/Resources/prepare-runtime.py" "$bundle"
 fi
 exec "$bundle/Contents/MacOS/Emacs" --fg-daemon
fi
for binary in "$root/bin/emacs-x11" "$root/bin/emacs-real" /Applications/Emacs.app/Contents/MacOS/Emacs /usr/bin/emacs; do
 [[ ! -x $binary ]] || exec "$binary" --fg-daemon
done
echo 'No native Emacs binary. Set EMACS_BINARY in Software/config/local/env.sh.' >&2
exit 1
