;;; test-emacs-markdown.el --- Configured Markdown integration -*- lexical-binding: t; -*-
;; Load in an Emacs using this profile, then run profile-markdown-* tests.
(require 'ert)
(require 'cl-lib)
(require 'init-markdown)
(require 'init-package)

(ert-deftest profile-markdown-pinned-package-is-not-upgraded ()
  (let* ((descriptor (cadr (assq 'markdown-ts-appear package-alist)))
         (package-alist (list (list 'markdown-ts-appear descriptor))))
    (should descriptor)
    (cl-letf (((symbol-function 'package-vc-upgrade)
               (lambda (&rest _) (ert-fail "Upgraded renderer's incompatible API"))))
      (should-not (plist-get (my-package--upgrade-vc-packages) :failures)))))

(ert-deftest profile-markdown-render-modes-preserve-source ()
  (with-temp-buffer
    (insert "# Heading\n\nParagraph.\n\n| A | B |\n|---|---|\n| 1 | 2 |\n\n$x^2$\n")
    (let ((source (buffer-string)))
      (init-markdown-mode)
      (should (eq major-mode 'markdown-ts-mode))
      (should (eq init-markdown-render-mode 'live))
      (should (boundp 'markdown-ts-appear-math--objects))
      (should (fboundp 'markdown-ts-appear-math--refresh))
      (font-lock-ensure)
      (my-markdown-render-preview)
      (should buffer-read-only)
      (my-markdown-render-source)
      (should-not buffer-read-only)
      (my-markdown-render-live)
      (font-lock-ensure)
      (should (equal source (buffer-substring-no-properties (point-min) (point-max)))))))

(ert-deftest profile-markdown-mathjax-renders-svg ()
  (should (init-markdown-math-preview-available-p))
  (let (result)
    (mathjax-render (lambda (data) (setq result data)) "\\frac{1}{2}+x^2")
    (let ((deadline (+ (float-time) 15)))
      (while (and (not result) (< (float-time) deadline))
        (accept-process-output nil 0.1)))
    (should result)
    (should-not (alist-get 'error result))
    (should (string-match-p "<svg" (alist-get 'svg result)))))

(ert-deftest profile-markdown-missing-code-grammar-does-not-prompt ()
  (let ((available (symbol-function 'treesit-language-available-p))
        (treesit-auto-install-grammar 'ask))
    (cl-letf (((symbol-function 'treesit-language-available-p)
               (lambda (language &rest args)
                 (unless (eq language 'toml)
                   (apply available language args))))
              ((symbol-function 'y-or-n-p)
               (lambda (&rest _) (ert-fail "Code highlighting asked to install a grammar"))))
      (with-temp-buffer
        (insert "# Configuration\n\n```toml\nname = \"example\"\n```\n")
        (init-markdown-mode)
        (markdown-ts--harvest-mode-treesit-configuration 'toml-ts-mode)
        (font-lock-ensure)))))
