;;; test-emacs-restart.el --- Service restart routing -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(setq native-comp-enable-subr-trampolines nil)
(load (expand-file-name "../emacs.d/lisp/init-restart.el" (file-name-directory load-file-name)) nil t)

(ert-deftest profile-restart-launchd-requires-current-pid ()
  (let ((system-type 'darwin)
        (pid (emacs-pid)))
    (dolist (reported (list pid (1+ pid) nil))
      (cl-letf (((symbol-function 'daemonp) (lambda () t))
                ((symbol-function 'call-process)
                 (lambda (&rest _)
                   (when reported (insert (format "service = {\n\tpid = %d\n}\n" reported)))
                   (if reported 0 1))))
        (should (eq (not (null (my-emacs--launchd-user-service-p))) (eq reported pid)))))))

(ert-deftest profile-restart-launchd-helper-only-on-accepted-exit ()
  (dolist (accept '(nil t))
    (let ((kill-emacs-hook nil) calls)
      (cl-letf (((symbol-function 'my-emacs--launchd-user-service-p) (lambda () t))
                ((symbol-function 'file-executable-p) (lambda (_) t))
                ((symbol-function 'my-emacs--reopen-after-exit)
                 (lambda (_bundle pid) (push pid calls)))
                ((symbol-function 'save-buffers-kill-emacs)
                 (lambda (&optional _arg restart)
                   (should-not restart)
                   (when accept (run-hooks 'kill-emacs-hook))))
                ((symbol-function 'restart-emacs) (lambda () (ert-fail "Must not re-exec"))))
        (my-restart-emacs)
        (should (equal calls (and accept (list (emacs-pid)))))
        (should-not kill-emacs-hook)))))

(ert-deftest profile-restart-helper-detached-through-launchservices ()
  (let (arguments)
    (cl-letf (((symbol-function 'call-process)
               (lambda (&rest args) (setq arguments args) 0)))
      (my-emacs--reopen-after-exit "/Applications/Emacs Client.app" 123)
      (should (equal arguments '("/usr/bin/open" nil nil nil "-n"
                                "/Applications/Emacs Client.app" "--args"
                                "--after-pid=123" "--new-window"))))))

(ert-deftest profile-restart-unmanaged-session-uses-built-in ()
  (let (called)
    (cl-letf (((symbol-function 'my-emacs--launchd-user-service-p) (lambda () nil))
              ((symbol-function 'my-emacs--systemd-user-service-p) (lambda () nil))
              ((symbol-function 'restart-emacs) (lambda () (setq called t))))
      (my-restart-emacs)
      (should called))))

(ert-deftest profile-restart-systemd-retains-nonblocking-route ()
  (let (arguments)
    (cl-letf (((symbol-function 'my-emacs--launchd-user-service-p) (lambda () nil))
              ((symbol-function 'my-emacs--systemd-user-service-p) (lambda () t))
              ((symbol-function 'call-process)
               (lambda (&rest args) (setq arguments args) 0)))
      (my-restart-emacs)
      (should (equal arguments '("systemctl" nil t nil "--user" "--no-block"
                                "restart" "emacs.service"))))))
